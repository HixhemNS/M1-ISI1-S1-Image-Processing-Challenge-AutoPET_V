    "import os\n",
    "import glob\n",
    "import subprocess\n",
    "import shutil\n",
    "import numpy as np\n",
    "import nibabel as nib\n",
    "from scipy.ndimage import label, distance_transform_edt\n",
    "\n",
    "# Lesion components use 26-connectivity (see the Step 2 metrics cell).\n",
    "STRUCT26 = np.ones((3, 3, 3), dtype=int)\n",
    "\n",
    "\n",
    "def click_voxel_inside(labels, comp):\n",
    "    \"\"\"Return one voxel guaranteed to lie deep inside component `comp`.\n",
    "\n",
    "    Uses the 3D Euclidean distance transform to select the interior voxel\n",
    "    farthest from the component boundary (pole of inaccessibility),\n",
    "    preventing clicks from landing on the outer surface of curved or\n",
    "    non-convex components. Single-voxel encoding (sigma=0, no smoothing).\n",
    "    \"\"\"\n",
    "    mask = (labels == comp)\n",
    "    dist = distance_transform_edt(mask)\n",
    "    return tuple(int(v) for v in np.unravel_index(np.argmax(dist), mask.shape))\n",
    "\n",
    "# Step 3 protocol:\n",
    "# single-voxel clicks, 2 clicks per iteration (1 foreground + 1 background),\n",
    "# accumulated across iterations. Iteration 1 uses the baseline prediction,\n",
    "# adds the first clicks and runs inference, so iter_1 is AFTER the first\n",
    "# correction round, not a repeat of the baseline.\n",
    "#\n",
    "# 1. Setup storage\n",
    "temp_input = \"/kaggle/temp/interactive_input\"\n",
    "temp_output = \"/kaggle/temp/interactive_output\"\n",
    "final_masks_dir = \"/kaggle/working/predictions\"\n",
    "\n",
    "os.makedirs(temp_input, exist_ok=True)\n",
    "os.makedirs(temp_output, exist_ok=True)\n",
    "os.makedirs(final_masks_dir, exist_ok=True)\n",
    "\n",
    "# 2. Get evaluation patients\n",
    "eval_pet_files = sorted(glob.glob(\"/kaggle/working/imagesTs_gz/*_0001.nii.gz\"))\n",
    "raw_base_dir = \"/kaggle/input/datasets/nshichembenmalek/autopet-deep-psma-subset\"\n",
    "if not os.path.exists(raw_base_dir):\n",
    "    raw_base_dir = \"/kaggle/input/autopet-deep-psma-subset\"\n",
    "\n",
    "# Environment vars\n",
    "subset_base_dir = \"/kaggle/input/datasets/nshichembenmalek/autopet-v-nnunet-subset-1\"\n",
    "if not os.path.exists(subset_base_dir):\n",
    "    subset_base_dir = \"/kaggle/input/autopet-v-nnunet-subset-1\"\n",
    "\n",
    "nnunet_env = os.environ.copy()\n",
    "nnunet_env[\"nnUNet_raw\"] = \"/kaggle/working/nnUNet_raw\"\n",
    "nnunet_env[\"nnUNet_preprocessed\"] = \"/kaggle/working/nnUNet_preprocessed\"\n",
    "nnunet_env[\"nnUNet_results\"] = os.path.join(subset_base_dir, \"autoPETV\", \"nnunet-baseline\", \"nnUNet_results\")\n",
    "\n",
    "# Initialize a state tracker to accumulate scribbles across iterations\n",
    "scribbles_state = {}\n",
    "for src_pet in eval_pet_files:\n",
    "    pat_id = os.path.basename(src_pet).replace(\"_0001.nii.gz\", \"\")\n",
    "    pet_shape = nib.load(src_pet).shape\n",
    "    scribbles_state[pat_id] = {\n",
    "        'fg': np.zeros(pet_shape, dtype=np.uint8),\n",
    "        'bg': np.zeros(pet_shape, dtype=np.uint8)\n",
    "    }\n",
    "\n",
    "# OUTER LOOP: Process by Iteration to batch GPU inference\n",
    "for iteration in range(1, 6):\n",
    "    print(f\"\\n--- Starting Iteration {iteration}/5 for ALL patients ---\")\n",
    "    \n",
    "    # Clean temp folders for the batch\n",
    "    for f in glob.glob(os.path.join(temp_input, \"*\")): os.remove(f)\n",
    "    for f in glob.glob(os.path.join(temp_output, \"*\")): os.remove(f)\n",
    "    \n",
    "    # INNER LOOP: Prepare inputs and simulate corrections for all patients\n",
    "    for src_pet in eval_pet_files:\n",
    "        pat_id = os.path.basename(src_pet).replace(\"_0001.nii.gz\", \"\")\n",
    "        \n",
    "        # Symlink CT and PET\n",
    "        src_ct = os.path.join(\"/kaggle/working/imagesTs_gz\", f\"{pat_id}_0000.nii.gz\")\n",
    "        os.symlink(src_ct, os.path.join(temp_input, f\"{pat_id}_0000.nii.gz\"))\n",
    "        os.symlink(src_pet, os.path.join(temp_input, f\"{pat_id}_0001.nii.gz\"))\n",
    "        \n",
    "        # Load GT and previous prediction\n",
    "        gt_path = os.path.join(raw_base_dir, pat_id, \"PSMA\", \"TTB.nii\")\n",
    "        gt_data = nib.load(gt_path).get_fdata() > 0\n",
    "        \n",
    "        if iteration == 1:\n",
    "            prev_pred_path = f\"/kaggle/working/inference_baseline/{pat_id}.nii.gz\"\n",
    "        else:\n",
    "            prev_pred_path = f\"{final_masks_dir}/iter_{iteration-1}/{pat_id}.nii.gz\"\n",
    "            \n",
    "        pred_data = nib.load(prev_pred_path).get_fdata() > 0\n",
    "        \n",
    "        # Retrieve accumulated scribbles for this specific patient\n",
    "        fg_scribbles = scribbles_state[pat_id]['fg']\n",
    "        bg_scribbles = scribbles_state[pat_id]['bg']\n",
    "        \n",
    "        # Simulate Corrections (voxel-level error components, 26-connectivity)\n",
    "        fp_voxels = np.logical_and(pred_data, ~gt_data) & (bg_scribbles == 0)\n",
    "        fp_labels, fp_num = label(fp_voxels, structure=STRUCT26)\n",
    "        if fp_num > 0:\n",
    "            largest_fp = np.argmax(np.bincount(fp_labels.flat)[1:]) + 1\n",
    "            # Single-voxel background click inside the largest FP component\n",
    "            bg_scribbles[click_voxel_inside(fp_labels, largest_fp)] = 1\n",
    "        fn_voxels = np.logical_and(~pred_data, gt_data) & (fg_scribbles == 0)\n",
    "        fn_labels, fn_num = label(fn_voxels, structure=STRUCT26)\n",
    "        if fn_num > 0:\n",
    "            largest_fn = np.argmax(np.bincount(fn_labels.flat)[1:]) + 1\n",
    "            # Single-voxel foreground click inside the largest FN component\n",
    "            fg_scribbles[click_voxel_inside(fn_labels, largest_fn)] = 1\n",
    "        pet_affine = nib.load(src_pet).affine\n",
    "        nib.save(nib.Nifti1Image(fg_scribbles, pet_affine), os.path.join(temp_input, f\"{pat_id}_0002.nii.gz\"))\n",
    "        nib.save(nib.Nifti1Image(bg_scribbles, pet_affine), os.path.join(temp_input, f\"{pat_id}_0003.nii.gz\"))\n",
    "        \n",
    "    # Run batch inference ONCE for the whole iteration\n",
    "    print(f\"  Running nnUNet batch prediction for iteration {iteration}...\")\n",
    "    cmd = [\"nnUNetv2_predict\", \"-i\", temp_input, \"-o\", temp_output, \"-d\", \"998\", \"-c\", \"3d_fullres\", \"-f\", \"0\", \"--disable_tta\"]\n",
    "    result = subprocess.run(cmd, env=nnunet_env, capture_output=True, text=True)\n",
    "    \n",
    "    if result.returncode != 0:\n",
    "        print(f\"nnU-Net crashed on Iteration {iteration}:\")\n",
    "        print(result.stderr)\n",
    "        break\n",
    "        \n",
    "    # Distribute outputs to the final iteration directory\n",
    "    iter_dir = os.path.join(final_masks_dir, f\"iter_{iteration}\")\n",
    "    os.makedirs(iter_dir, exist_ok=True)\n",
    "    \n",
    "    for pred_file in glob.glob(os.path.join(temp_output, \"*.nii.gz\")):\n",
    "        shutil.move(pred_file, os.path.join(iter_dir, os.path.basename(pred_file)))"
   ]
