    "import os\n",
    "import numpy as np\n",
    "import nibabel as nib\n",
    "\n",
    "# Cell 1 — Diagnose train_0011 / train_0013 before any Step 3 run.\n",
    "# A gross grid/affine mismatch here means a Step 1/2 formatting problem,\n",
    "# not a model failure. A matching grid with a large centroid distance and\n",
    "# near-zero overlap means a genuine failure (the click rescue in Step 3\n",
    "# is then the right test, not a formatting fix).\n",
    "raw_base_dir = \"/kaggle/input/datasets/nshichembenmalek/autopet-deep-psma-subset\"\n",
    "if not os.path.exists(raw_base_dir):\n",
    "    raw_base_dir = \"/kaggle/input/autopet-deep-psma-subset\"\n",
    "\n",
    "\n",
    "def world_centroid(mask, affine):\n",
    "    coords = np.argwhere(mask)\n",
    "    if len(coords) == 0:\n",
    "        return None\n",
    "    vox = coords.mean(axis=0)\n",
    "    world = affine @ np.array([vox[0], vox[1], vox[2], 1.0])\n",
    "    return world[:3]\n",
    "\n",
    "\n",
    "print(f\"{'Exam':<12} | {'Pred shape':<16} | {'GT shape':<16} | {'Pred vox':<10} | {'GT vox':<10} | {'Overlap':<10} | {'Dice':<7} | {'Centroid dist (mm)':<18}\")\n",
    "print(\"-\" * 130)\n",
    "for pat_id in [\"train_0011\", \"train_0013\"]:\n",
    "    pred_path = f\"/kaggle/working/inference_baseline/{pat_id}.nii.gz\"\n",
    "    gt_path = os.path.join(raw_base_dir, pat_id, \"PSMA\", \"TTB.nii\")\n",
    "    pred_nii = nib.load(pred_path)\n",
    "    gt_nii = nib.load(gt_path)\n",
    "    pred = pred_nii.get_fdata() > 0\n",
    "    gt = gt_nii.get_fdata() > 0\n",
    "    inter = int(np.logical_and(pred, gt).sum())\n",
    "    dice = (2.0 * inter) / (pred.sum() + gt.sum() + 1e-8)\n",
    "    pc, gc = world_centroid(pred, pred_nii.affine), world_centroid(gt, gt_nii.affine)\n",
    "    dist = float(np.linalg.norm(pc - gc)) if (pc is not None and gc is not None) else float(\"nan\")\n",
    "    grid = \"MATCH\" if (pred_nii.shape == gt_nii.shape and np.allclose(pred_nii.affine, gt_nii.affine)) else \"CHECK: grid/affine differ\"\n",
