    "import os\n",
    "import nibabel as nib\n",
    "import numpy as np\n",
    "import matplotlib.pyplot as plt\n",
    "from matplotlib.colors import ListedColormap\n",
    "\n",
    "raw_base_dir = \"/kaggle/input/datasets/nshichembenmalek/autopet-deep-psma-subset\"\n",
    "if not os.path.exists(raw_base_dir):\n",
    "    raw_base_dir = \"/kaggle/input/autopet-deep-psma-subset\"\n",
    "\n",
    "eval_patients = [\n",
    "    \"train_0011\", \"train_0012\", \"train_0013\", \"train_0014\", \"train_0015\",\n",
    "    \"train_0016\", \"train_0017\", \"train_0018\", \"train_0019\", \"train_0020\"\n",
    "]\n",
    "\n",
    "for pat_id in eval_patients:\n",
    "    # Create a new standalone figure for the current patient\n",
    "    fig, axes = plt.subplots(1, 4, figsize=(18, 4.5))\n",
    "    \n",
    "    ct_path = f\"/kaggle/working/imagesTs_gz/{pat_id}_0000.nii.gz\"\n",
    "    pet_path = f\"/kaggle/working/imagesTs_gz/{pat_id}_0001.nii.gz\"\n",
    "    gt_path = os.path.join(raw_base_dir, pat_id, \"PSMA\", \"TTB.nii\")\n",
    "    pred0_path = f\"/kaggle/working/inference_baseline/{pat_id}.nii.gz\"\n",
    "    pred5_path = f\"/kaggle/working/predictions/iter_5/{pat_id}.nii.gz\"\n",
    "\n",
    "    # 1. Load ONLY the boolean masks into memory (fastest)\n",
    "    gt = nib.load(gt_path).get_fdata().astype(bool)\n",
    "    pred0 = nib.load(pred0_path).get_fdata().astype(bool)\n",
    "    pred5 = nib.load(pred5_path).get_fdata().astype(bool)\n",
    "\n",
    "    # 2. Restrict slice selection to slices containing Ground Truth (gt_per_slice > 0)\n",
    "    # and prioritize slices where true-positive overlap changed the most + GT burden is large.\n",
    "    # (Previously, unrestrictedpred5 ^ pred0 picked slices with 0 GT where only a false positive appeared.)\n",
    "    tp0_per_slice = (pred0 & gt).sum(axis=(0, 1))\n",
    "    tp5_per_slice = (pred5 & gt).sum(axis=(0, 1))\n",
    "    tp_change_per_slice = np.abs(tp5_per_slice.astype(int) - tp0_per_slice.astype(int))\n",
    "    diff_per_slice = (pred5 ^ pred0).sum(axis=(0, 1))\n",
    "    gt_per_slice = gt.sum(axis=(0, 1))\n",
    "\n",
    "    if gt_per_slice.max() > 0:\n",
    "        score = (2.0 * tp_change_per_slice + 0.5 * diff_per_slice + 1.0 * gt_per_slice) * (gt_per_slice > 0)\n",
    "        best_z = int(np.argmax(score))\n",
    "    else:\n",
    "        best_z = int(np.argmax(diff_per_slice))\n",
    "\n",
    "    # 3. LAZY LOAD: Read strictly the single 'best_z' 2D slice from the heavy CT/PET files\n",
    "    ct_sl = nib.load(ct_path).dataobj[:, :, best_z].T\n",
    "    pet_sl = nib.load(pet_path).dataobj[:, :, best_z].T\n",
    "\n",
    "    # 4. Process slices\n",
    "    ct_sl = np.clip(ct_sl, -150, 250)\n",
    "    pet_sl = np.clip(pet_sl, 0, 10)\n",
    "    gt_sl = gt[:, :, best_z].T\n",
    "    p0_sl = pred0[:, :, best_z].T\n",
    "    p5_sl = pred5[:, :, best_z].T\n",
    "\n",
