    "import os\n",
    "import nibabel as nib\n",
    "import numpy as np\n",
    "from scipy.ndimage import label, binary_fill_holes\n",
    "\n",
    "# Lesion components use 26-connectivity (see the Step 2 metrics cell).\n",
    "STRUCT26 = np.ones((3, 3, 3), dtype=int)\n",
    "\n",
    "base_preds_dir = \"/kaggle/working/predictions\"\n",
    "raw_base_dir = \"/kaggle/input/datasets/nshichembenmalek/autopet-deep-psma-subset\"\n",
    "if not os.path.exists(raw_base_dir):\n",
    "    raw_base_dir = \"/kaggle/input/autopet-deep-psma-subset\"\n",
    "\n",
    "eval_patients = [\"train_0011\", \"train_0012\", \"train_0013\", \"train_0014\", \"train_0015\",\n",
    "                 \"train_0016\", \"train_0017\", \"train_0018\", \"train_0019\", \"train_0020\"]\n",
    "\n",
    "# Threshold for small region filtering (remove artifacts smaller than 1.0 mL)\n",
    "MIN_VOL_ML = 1.0\n",
    "\n",
    "\n",
    "def dice(a, b):\n",
    "    return (2. * np.logical_and(a, b).sum()) / (a.sum() + b.sum() + 1e-8)\n",
    "\n",
    "\n",
    "def lesion_volumes(pred, gt, voxel_volume_ml):\n",
    "    # Lesion-level FPV/FNV: volume of 26-connected components with ZERO overlap.\n",
    "    # NOTE: these are NOT voxel-level FP/FN volumes. If post-processing\n",
    "    # removes a small predicted speck that was a GT component's only overlap,\n",
    "    # the whole GT component counts as missed, so lesion-level FNV can jump\n",
    "    # while voxel-level FN barely moves.\n",
    "    pred_labels, _ = label(pred, structure=STRUCT26)\n",
    "    gt_labels, _ = label(gt, structure=STRUCT26)\n",
    "    pred_overlaps = np.unique(pred_labels[gt > 0])\n",
    "    fp_mask = np.isin(pred_labels, pred_overlaps, invert=True) & (pred_labels > 0)\n",
    "    gt_overlaps = np.unique(gt_labels[pred > 0])\n",
    "    fn_mask = np.isin(gt_labels, gt_overlaps, invert=True) & (gt_labels > 0)\n",
    "    return fp_mask.sum() * voxel_volume_ml, fn_mask.sum() * voxel_volume_ml\n",
    "\n",
    "\n",
    "for iter_step in range(0, 6):\n",
    "    # 0 is the baseline from Step 2, 1-5 are from Step 3\n",
    "    if iter_step == 0:\n",
    "        pred_dir = \"/kaggle/working/inference_baseline\"\n",
    "    else:\n",
    "        pred_dir = os.path.join(base_preds_dir, f\"iter_{iter_step}\")\n",
    "\n",
    "    rows = []\n",
    "    for pat_id in eval_patients:\n",
    "        pred_path = os.path.join(pred_dir, f\"{pat_id}.nii.gz\")\n",
    "        gt_path = os.path.join(raw_base_dir, pat_id, \"PSMA\", \"TTB.nii\")\n",
    "        if not os.path.exists(pred_path) or not os.path.exists(gt_path):\n",
    "            continue\n",
    "        pred_nii = nib.load(pred_path)\n",
    "        gt_data = nib.load(gt_path).get_fdata() > 0\n",
    "        pred_data_pre = pred_nii.get_fdata() > 0\n",
    "        voxel_volume_ml = np.prod(pred_nii.header.get_zooms()) / 1000.0\n",
    "\n",
    "        # --- Morphological post-processing, kept SEPARATE ---\n",
    "        # 1. Hole filling alone (no size filter)\n",
    "        pred_data_hole = binary_fill_holes(pred_data_pre)\n",
    "        # 2. Hole filling + small-region filtering (combined Full step)\n",
    "        pred_data_full = pred_data_hole.copy()\n",
    "        labeled_preds, num_features = label(pred_data_full, structure=STRUCT26)\n",
    "        if num_features > 0:\n",
    "            component_sizes = np.bincount(labeled_preds.flat)\n",
    "            component_sizes[0] = 0  # Ignore background\n",
    "            small_components = np.where((component_sizes * voxel_volume_ml) < MIN_VOL_ML)[0]\n",
    "            pred_data_full[np.isin(labeled_preds, small_components)] = 0\n",
    "\n",
    "        fp_vox_pre = float(np.logical_and(pred_data_pre, ~gt_data).sum()) * voxel_volume_ml\n",
    "        fp_vox_full = float(np.logical_and(pred_data_full, ~gt_data).sum()) * voxel_volume_ml\n",
    "        fn_vox_pre = float(np.logical_and(~pred_data_pre, gt_data).sum()) * voxel_volume_ml\n",
    "        fn_vox_full = float(np.logical_and(~pred_data_full, gt_data).sum()) * voxel_volume_ml\n",
    "        fpv_les_pre, fnv_les_pre = lesion_volumes(pred_data_pre, gt_data, voxel_volume_ml)\n",
    "        fpv_les_full, fnv_les_full = lesion_volumes(pred_data_full, gt_data, voxel_volume_ml)\n",
    "        rows.append((pat_id, dice(pred_data_pre, gt_data), dice(pred_data_hole, gt_data),\n",
    "                     dice(pred_data_full, gt_data), fp_vox_full, fn_vox_pre, fn_vox_full,\n",
    "                     fpv_les_full, fnv_les_full, fp_vox_pre, fpv_les_pre, fnv_les_pre))\n",
    "\n",
    "    print(f\"\\n--- Iteration {iter_step} Post-Processing: Dice (Pre / Hole-only / Hole+Filter) ---\")\n",
    "    print(f\"{'Exam ID':<15} | {'Dice (Pre)':<10} | {'Dice (Hole)':<11} | {'Dice (Full)':<11}\")\n",
    "    print(\"-\" * 56)\n",
    "    for r in rows:\n",
    "        print(f\"{r[0]:<15} | {r[1]:<10.4f} | {r[2]:<11.4f} | {r[3]:<11.4f}\")\n",
    "    if rows:\n",
    "        m_pre = np.mean([r[1] for r in rows])\n",
    "        m_hole = np.mean([r[2] for r in rows])\n",
    "        m_full = np.mean([r[3] for r in rows])\n",
    "        print(\"-\" * 56)\n",
    "        print(f\"{'MEAN':<15} | {m_pre:<10.4f} | {m_hole:<11.4f} | {m_full:<11.4f}\")\n",
    "\n",
    "    print(f\"\\n--- Iteration {iter_step} Post-Processing: volumes for the Full (Hole+Filter) mask ---\")\n",
    "    print(f\"{'Exam ID':<15} | {'FP vox (mL)':<12} | {'FN vox Pre (mL)':<15} | {'FN vox Full (mL)':<16} | {'FPV les (mL)':<12} | {'FNV les (mL)':<12}\")\n",
    "    print(\"-\" * 92)\n",
    "    for r in rows:\n",
    "        print(f\"{r[0]:<15} | {r[4]:<12.2f} | {r[5]:<15.2f} | {r[6]:<16.2f} | {r[7]:<12.2f} | {r[8]:<12.2f}\")\n",
    "    if rows:\n",
    "        print(\"-\" * 92)\n",
    "        print(f\"{'MEAN':<15} | {np.mean([r[4] for r in rows]):<12.2f} | {np.mean([r[5] for r in rows]):<15.2f} | {np.mean([r[6] for r in rows]):<16.2f} | {np.mean([r[7] for r in rows]):<12.2f} | {np.mean([r[8] for r in rows]):<12.2f}\")\n"
   ]
