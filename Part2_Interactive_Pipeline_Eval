    "import os\n",
    "import glob\n",
    "import nibabel as nib\n",
    "import numpy as np\n",
    "from scipy.ndimage import label\n",
    "\n",
    "# Lesion components use 26-connectivity throughout this notebook.\n",
    "# (scipy's default is 6-connectivity, which splits diagonally touching\n",
    "# voxels and inflates component counts.)\n",
    "STRUCT26 = np.ones((3, 3, 3), dtype=int)\n",
    "\n",
    "pred_files = sorted(glob.glob(\"/kaggle/working/inference_baseline/*.nii.gz\"))\n",
    "raw_base_dir = \"/kaggle/input/datasets/nshichembenmalek/autopet-deep-psma-subset\"\n",
    "\n",
    "if not os.path.exists(raw_base_dir):\n",
    "    raw_base_dir = \"/kaggle/input/autopet-deep-psma-subset\"\n",
    "\n",
    "print(f\"{'Exam ID':<15} | {'Dice':<8} | {'FPV (mL)':<12} | {'FNV (mL)':<12}\")\n",
    "print(\"-\" * 55)\n",
    "\n",
    "for pred_path in pred_files:\n",
    "    exam_id = os.path.basename(pred_path).replace(\".nii.gz\", \"\")\n",
    "    gt_path = os.path.join(raw_base_dir, exam_id, \"PSMA\", \"TTB.nii\")\n",
    "    \n",
    "    if not os.path.exists(gt_path):\n",
    "        print(f\"Missing GT at: {gt_path}\")\n",
    "        continue\n",
    "        \n",
    "    pred_nii = nib.load(pred_path)\n",
    "    gt_nii = nib.load(gt_path)\n",
    "    \n",
    "    pred_data = pred_nii.get_fdata() > 0\n",
    "    gt_data = gt_nii.get_fdata() > 0\n",
    "    \n",
    "    if pred_nii.shape != gt_nii.shape:\n",
    "        print(f\"  WARNING shape mismatch for {exam_id}: pred {pred_nii.shape} vs GT {gt_nii.shape}\")\n",
    "    \n",
    "    # Calculate physical volume of one voxel in mL\n",
    "    voxel_volume_ml = np.prod(pred_nii.header.get_zooms()) / 1000.0\n",
    "    \n",
    "    # 1. Dice Score\n",
    "    intersection = np.logical_and(pred_data, gt_data).sum()\n",
    "    dice_score = (2. * intersection) / (pred_data.sum() + gt_data.sum() + 1e-8)\n",
    "    \n",
    "    # 2. Extract Connected Components\n",
    "    pred_labels, pred_num = label(pred_data, structure=STRUCT26)\n",
    "    gt_labels, gt_num = label(gt_data, structure=STRUCT26)\n",
    "    \n",
    "    # 3. False Positive Volume (FPV), LESION-LEVEL: volume of pred\n",
    "    # components that DO NOT overlap GT at all (not voxel-level FP volume;\n",
    "    # voxel-level FP/FN volumes are reported in the Step 4 cell).\n",
    "    pred_overlaps = np.unique(pred_labels[gt_data > 0])\n",
    "    fp_mask = np.isin(pred_labels, pred_overlaps, invert=True) & (pred_labels > 0)\n",
    "    fpv_ml = fp_mask.sum() * voxel_volume_ml\n",
    "    \n",
    "    # 4. False Negative Volume (FNV): GT lesions that DO NOT overlap with Pred\n",
    "    gt_overlaps = np.unique(gt_labels[pred_data > 0])\n",
    "    fn_mask = np.isin(gt_labels, gt_overlaps, invert=True) & (gt_labels > 0)\n",
    "    fnv_ml = fn_mask.sum() * voxel_volume_ml\n",
    "    \n",
    "    print(f\"{exam_id:<15} | {dice_score:<8.4f} | {fpv_ml:<12.2f} | {fnv_ml:<12.2f}\")"
